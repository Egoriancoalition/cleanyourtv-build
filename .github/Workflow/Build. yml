name: Build CleanYourTV APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Install Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Download source
        run: |
          curl -L \
            https://github.com/andikatuluspangestu/cleanyourtv/archive/refs/heads/polytron-glass-launcher.zip \
            -o source.zip
          unzip source.zip -d source

      - name: Build APK
        run: |
          cd source/cleanyourtv-polytron-glass-launcher/launcher
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Save APK
        uses: actions/upload-artifact@v4
        with:
          name: CleanYourTV-APK
          path: source/cleanyourtv-polytron-glass-launcher/launcher/**/build/outputs/apk/debug/*.apk
